# ─── Datenbank (Supabase PostgreSQL) ─────────────────────────────────────────
# DATABASE_URL: der Pooler (PgBouncer, Port 6543). Benutzername enthält die
# Projekt-Referenz: postgres.[PROJECT-REF]. Die App läuft ausschließlich hierüber.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direktverbindung (Port 5432) — dient den Migrationen
# (prisma migrate), die über den Pooler nicht laufen können.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Authentifizierung (Better Auth) ─────────────────────────────────────────
BETTER_AUTH_SECRET=""        # mind. 32 Zeichen, generieren: openssl rand -base64 32
# BETTER_AUTH_URL wird nicht mehr gebraucht: Die Basis-Adresse kommt aus
# src/lib/umgebung.ts (Produktion NEXT_PUBLIC_APP_URL, Previews ihre
# Vercel-Adresse, lokal localhost). Darf gesetzt bleiben, wirkt aber nicht.

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."           # in Prod: sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # in Prod: pk_live_...
STRIPE_WEBHOOK_SECRET="whsec_..."        # aus: stripe listen --print-secret
STRIPE_CONNECT_CLIENT_ID="ca_..."        # Stripe Dashboard → Connect Settings

# ─── E-Mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="bestellung@deine-domain.at"  # muss verifizierte Resend-Domain sein

# ─── File Upload (Vercel Blob) ────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."  # Vercel Dashboard → Storage → Blob

# ─── App-Konfiguration ────────────────────────────────────────────────────────
# NUR in Vercel Production setzen. Previews brauchen sie nicht — sie leiten
# ihre Adresse aus den Vercel-Systemvariablen ab (VERCEL_ENV, VERCEL_URL,
# VERCEL_BRANCH_URL, VERCEL_GIT_COMMIT_REF; „Automatically expose System
# Environment Variables" muss im Projekt aktiv sein). Lokal gilt localhost.
# Fehlt sie in Produktion, gibt es bewusst keinen Ersatz (src/lib/umgebung.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # in Prod: https://deine-domain.at

# ─── Cron-Job Absicherung ─────────────────────────────────────────────────────
CRON_SECRET=""   # zufälliger String, z.B. openssl rand -hex 16

# ─── Triage (Fehlerbriefkasten) ───────────────────────────────────────────────
# TRIAGE_TOKEN schützt die Leseroute /api/triage/export (nur GET, nur lesend):
# in Vercel setzen (openssl rand -hex 24) UND lokal denselben Wert für das CLI.
# Fehlt er in Vercel, antwortet die Route immer 401.
TRIAGE_TOKEN=""
# Nur lokal (.env.local), nie in Vercel — das CLI `pnpm briefkasten`:
#   empfohlen: Leseroute (braucht keinen Datenbankzugang)
# TRIAGE_EXPORT_URL="https://<app>/api/triage/export"
#   Alternative bei Direktzugang zur Datenbank: Nur-Lese-Rolle (nur SELECT)
# TRIAGE_DATABASE_URL="postgresql://triage_leser:<passwort>@<host>:5432/postgres"

# ─── Optional: Sentry Error Tracking (ohne DSN läuft alles unverändert) ──────
# EINE Variable für Server, Edge und Browser — der DSN ist kein Geheimnis,
# sondern eine Einwurf-Adresse (Sentry-Projekt: Region EU anlegen).
# NEXT_PUBLIC_SENTRY_DSN=""
