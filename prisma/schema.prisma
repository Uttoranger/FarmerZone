generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === ENUMS ===

enum UserRole {
  CUSTOMER
  FARMER
  ADMIN
}

enum OrderStatus {
  PENDING_CONFIRMATION // bei Vor-Ort-Zahlung: warten auf E-Mail-Bestätigung
  PAID                 // bei Online-Zahlung: bezahlt
  CONFIRMED            // bei Vor-Ort-Zahlung: bestätigt, wartet auf Bauer
  IN_PREPARATION       // Bauer kommissioniert
  READY                // bereit zur Abholung
  PICKED_UP            // abgeholt (bei Vor-Ort-Zahlung: + bezahlt)
  CANCELLED            // storniert
  NOT_PICKED_UP        // nicht abgeholt nach Frist
}

enum PaymentMethod {
  ONLINE       // Stripe
  ONSITE_CASH  // Bar bei Abholung
  ONSITE_CARD  // Karte bei Abholung
}

enum PaymentStatus {
  PENDING   // noch nicht bezahlt
  PAID      // bezahlt
  FAILED    // fehlgeschlagen
  REFUNDED  // zurückerstattet
}

enum StatusPostAnlass {
  FRESH_PRODUCT
  NEW_SEASON
  PROMOTION
  ANNOUNCEMENT
}

enum SalesChannel {
  PLATFORM  // automatisch über die Plattform
  WHATSAPP  // manuell eingetragen
  HOFLADEN  // manuell eingetragen
  MARKT     // manuell eingetragen
  BUSINESS  // Geschäftskunde
  OTHER     // sonstiges
}

enum ProductUnit {
  STUECK
  KG
  G
  LITER
  ML
  M3
  PAKET
  // Sprint Bereiche 1 — Gewicht steht in FutterKennzeichnung.nettoMenge,
  // unitSize bleibt leer (Zod). Im Formular nur in den Bereichen Futtermittel
  // und Sonstiges angeboten (Brennholz im Big Bag).
  BALLEN
  BIGBAG
}

// Reihenfolge = Reihenfolge in PostgreSQL. Die vier Futter-Kategorien kamen per
// ADD VALUE … BEFORE 'BRENNHOLZ' hinzu, die Altlast FUTTERMITTEL bleibt davor
// stehen (Postgres sortiert nicht um). Die Auswahl-Reihenfolge entscheidet
// src/lib/taxonomie.ts (CATEGORY_OPTIONS), nicht dieses Enum.
enum ProductCategory {
  MILCH
  EIER
  FLEISCH
  FISCH
  GEMUESE
  OBST
  BROT
  HONIG
  GETRAENKE
  FUTTERMITTEL // ALTLAST seit Bereiche 1 — Zod lehnt ab, Cleanup-Sprint entfernt
  HEU_STROH
  GETREIDE_KOERNER
  MISCHFUTTER
  ERGAENZUNGSFUTTER
  BRENNHOLZ
  SONSTIGES
}

// === TAXONOMIE (Sprint Taxonomie 1) ===
//
// Zweite Kategorieebene. Welche L2 zu welcher L1 gehört, entscheidet
// ausschließlich src/lib/taxonomie.ts (TAXONOMIE) — die Datenbank kennt nur
// die Werte, nicht die Zuordnung. Fisch, Brot, Getränke, Brennholz und
// Sonstiges haben bewusst keine Unterkategorien.
enum ProductSubcategory {
  // Fleisch
  RIND
  SCHWEIN
  HAEHNCHEN
  PUTE
  LAMM
  WILD
  WURST
  // Eier
  EIER_BIO
  EIER_FREILAND
  EIER_BODENHALTUNG
  // Milch
  TRINKMILCH
  KAESE
  JOGHURT_TOPFEN
  BUTTER
  // Gemüse
  ERDAEPFEL
  WURZELGEMUESE
  BLATT_SALAT
  KOHL
  FRUCHTGEMUESE
  KUERBIS
  ZWIEBEL_LAUCH
  KRAEUTER
  EINGELEGT
  // Obst
  KERNOBST
  STEINOBST
  BEEREN
  NUESSE
  EINGEKOCHT_GETROCKNET
  // Honig
  BLUETENHONIG
  WALDHONIG
  SORTENHONIG
  BIENENPRODUKTE
  // ALTLAST seit Bereiche 1 — der Rechtsbegriff steht jetzt in
  // FutterKennzeichnung.futtermittelart. Zod lehnt ab, Cleanup-Sprint entfernt.
  EINZELFUTTERMITTEL
  MISCHFUTTERMITTEL
  ERGAENZUNGSFUTTERMITTEL
  // Heu & Stroh
  WIESENHEU
  LUZERNE
  STROH
  SILAGE
  // Getreide & Körner
  MAIS
  HAFER
  GERSTE
  WEIZEN
  ROGGEN
  TRITICALE
}

// === BEREICHE (Sprint Bereiche 1, docs/konzepte/bereiche.md) ===

// Wer ein Produkt kaufen darf. ≠ ALLE nur im Bereich Futtermittel (Zod).
enum Abgabe {
  ALLE
  NUR_BETRIEBE
}

// Futtermittelart nach VO (EG) 767/2009 — Pflichtangabe, an die Kategorie
// gebunden (futtermittelartenFuer in src/lib/taxonomie.ts).
enum Futtermittelart {
  EINZELFUTTERMITTEL
  ALLEINFUTTERMITTEL
  ERGAENZUNGSFUTTERMITTEL
  MINERALFUTTERMITTEL
}

enum NettoEinheit {
  KG
  LITER
}

// Erklärt, welche Nummer in Farm.betriebsnummer steht (LFBIS, BAES/BVL, α-Nummer).
enum Betriebsstatus {
  PRIMAERPRODUKTION
  REGISTRIERT
  ZUGELASSEN
}

enum KaeuferArt {
  PRIVAT
  BETRIEB
}

// Benannte Siegel — orthogonal zur Kategorie, mehrere je Produkt möglich.
enum ProductLabel {
  BIO
  GENTECHNIKFREI
  AMA_GUETESIEGEL
}

// Zieltierarten der Futtermittel-Kennzeichnung.
enum Tierart {
  PFERD
  RIND
  GEFLUEGEL
  SCHWEIN
  SCHAF_ZIEGE
  HEIMTIER
}

enum BannerType {
  GRADIENT
  PHOTO
}

// === FEHLERBRIEFKASTEN ===
//
// GRUNDSATZ: Der Briefkasten ist ein EINGANGSKANAL, kein Befehlskanal. Höfe und
// Kundinnen melden Fehler, Wünsche und Fragen; aus Meldungen entstehen
// Vorschläge — entscheiden und mergen tut ausschließlich der Betreiber.
// Wünsche werden gebündelt und gezählt (clusterKey), nie automatisch zu
// Aufgaben. Kein Ticket-System, keine Threads, keine automatische
// Klassifikation, keine automatische Sprint-Auslösung.

enum MeldungArt {
  FEHLER
  WUNSCH
  FRAGE
}

// Interne Triage-Status. Was der Hof davon sieht, übersetzt src/lib/meldung.ts
// (NEU → „Eingegangen", KEIN_FEHLER → „Kein Fehler — Antwort lesen", …).
// VERMUTLICH_WUNSCH: Vorschlag der KI, dass eine Fehler-Meldung ein Wunsch ist
// — der Mensch entscheidet im Admin; der Melder sieht „Angesehen".
enum MeldungStatus {
  NEU
  GEPRUEFT
  VERMUTLICH_WUNSCH
  GEPLANT
  ERLEDIGT
  KEIN_FEHLER
  DUPLIKAT
}

// Wofür die Plattform Geld ausgibt — die Kategorie gruppiert nur die Liste,
// sie rechnet nichts.
enum KostenKategorie {
  HOSTING
  DATENBANK
  KI
  WERKZEUGE
  DOMAIN
  EMAIL
  SONSTIGES
}

// Wie oft der Betrag anfällt. JAEHRLICH wird auf die zwölf Monate des
// Abo-Jahres verteilt (src/lib/finanzen.ts), EINMALIG zählt nur im Monat von ab.
enum KostenRhythmus {
  MONATLICH
  JAEHRLICH
  EINMALIG
}

// === ENTITÄTEN ===

model User {
  id            String   @id
  email         String   @unique
  name          String?
  phone         String?
  image         String?
  role          UserRole @default(CUSTOMER)
  // Plattformbetreiber-Recht für /admin. Bewusst SEPARAT von `role`: role
  // steuert den Bauernbereich (src/app/(farmer)/layout.tsx prüft auf FARMER).
  // Ein Betreiber, der selbst einen Hof führt, muss beides sein können.
  isAdmin       Boolean  @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm     Farm?
  orders   Order[]
  sessions Session[]
  accounts Account[]

  @@index([email])
}

// === BETTER AUTH TABELLEN ===

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Farm {
  id          String  @id @default(cuid())
  slug        String  @unique // für URL: /hof-mueller
  name        String
  ownerName   String
  description String  @db.Text
  address     String
  postalCode  String
  city        String
  // Land des Hofes: "AT" oder "DE" (src/lib/laender.ts). Bewusst String mit
  // Default statt Enum — die Migration setzt damit ALLE Bestandshöfe ohne
  // Backfill-Skript auf AT, und ein drittes Land später kostet keine
  // Enum-Migration. Erlaubt sind trotzdem nur AT und DE: Das erzwingt das
  // Zod-Schema der Server-Action (src/server/actions/farm.ts).
  country     String  @default("AT")
  // Standort für die spätere Kundenkarte. Nullbar: Bestandshöfe haben noch
  // keine Koordinaten und werden über die Einstiegs-Checkliste angeleitet,
  // den Punkt im Hofprofil zu bestätigen (kein Backfill).
  latitude    Float?
  longitude   Float?
  phone       String
  email       String
  logoUrl     String?
  bannerUrl   String?

  // Auftritt / Präsentation
  tagline        String?
  foundedYear    Int?
  aboutText      String?    @db.Text
  bannerType     BannerType @default(GRADIENT)
  bannerValue    String?    // gradient preset key or uploaded photo URL
  bannerFocusY   Int        @default(50) // vertikaler Fokuspunkt des Titelbilds: 0=oben, 100=unten
  sectionsConfig Json?      // SectionConfig[] — which sections are visible and in which order

  // Stripe Connect
  stripeAccountId    String?  @unique
  stripeAccountReady Boolean  @default(false)

  // Zahlungsoptionen
  acceptsOnline      Boolean  @default(true)
  acceptsOnsite      Boolean  @default(true)
  onsiteMaxAmount    Decimal? @db.Decimal(10, 2)
  hasRegistrierkasse Boolean  @default(false)

  // Plattform-Konfiguration
  platformFeePercent Decimal @default(0) @db.Decimal(5, 2) // im Pilot: 0

  // Servicegebühr (Sprint servicegebuehr) — die Gebühr, die die KUNDIN auf den
  // Warenpreis zahlt; der Hof behält immer 100 % Warenpreis. Der Betreiber
  // stellt sie PRO HOF im Admin-Bereich ein. serviceFeeActiveFrom = null heißt
  // gebührenfrei (Voreinstellung für jeden neuen Hof); ein Datum heißt: Gebühr
  // gilt für Bestellungen AB diesem Zeitpunkt. Prozentsatz und Mindestgebühr
  // greifen nur, wenn ein Datum gesetzt ist. Berechnung: src/lib/servicegebuehr.ts.
  serviceFeePercent    Decimal   @default(4.9) @db.Decimal(5, 2)
  serviceFeeMinCents   Int       @default(50)
  serviceFeeActiveFrom DateTime?

  // Status
  isActive     Boolean @default(true)
  isPaused     Boolean @default(false)
  pauseMessage String?

  // Stilllegung — dauerhaft, aber umkehrbar. null = aktiver Hof.
  // Abgrenzung zu isPaused: Pause ist vorübergehend und lässt die Hofseite
  // mit Banner sichtbar; Stilllegung nimmt die Hofseite vom Netz (404) und
  // sperrt Checkout und Reservierung. Es wird NICHTS gelöscht — Bestelldaten
  // unterliegen der 7-jährigen Aufbewahrungspflicht.
  archivedAt DateTime?

  // Freischaltung durch den Plattformbetreiber. null = wartet auf Freigabe:
  // Der Bauer kann seinen Hof vollständig einrichten, öffentlich sichtbar und
  // bestellbar wird er erst nach der Freigabe im Admin-Bereich.
  // Abgrenzung: archivedAt ist ein Zustand, den der Bauer selbst setzt;
  // approvedAt setzt ausschließlich der Betreiber.
  approvedAt DateTime?

  // Betriebsnummer des Hofs (Sprint Bereiche 1, Rückfrage F6). Eine Eigenschaft
  // des HOFS, nicht des Produkts: Wer Futter nur kauft, hat keine
  // Kennzeichnung, braucht die Nummer aber im Checkout (NUR_BETRIEBE).
  // betriebsstatus erklärt, welche Nummer es ist. Die Plattform prüft sie nicht.
  betriebsnummer String?
  betriebsstatus Betriebsstatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner         User                       @relation(fields: [ownerId], references: [id])
  ownerId       String                     @unique
  products      Product[]
  orders        Order[]
  pickupSlots   PickupSlot[]
  manualSales   ManualSale[]
  subscriptions CustomerFarmSubscription[]
  statusPosts   StatusPost[]
  farmValues    FarmValue[]
  farmPhotos    FarmPhoto[]
  meldungen     Meldung[]

  @@index([slug])
}

model Product {
  id          String      @id @default(cuid())
  farmId      String
  name        String
  description String?     @db.Text
  imageUrl    String?
  price       Decimal     @db.Decimal(10, 2)
  vatRate     Decimal     @default(10) @db.Decimal(5, 2) // 10% Standard für Lebensmittel AT
  unit        ProductUnit
  unitSize    Decimal?    @db.Decimal(10, 3) // z.B. 0.5 für 500g
  stock       Int         @default(0)
  reservedStock Int       @default(0)
  isAvailable Boolean     @default(true)

  // Stammdaten (Sprint 17K)
  category          ProductCategory? // null = keine Angabe (heutiges Verhalten)
  countsTowardLimit Boolean          @default(true) // zählt zur 55.000-€-Grenze (Be- & Verarbeitung)
  sortOrder         Int              @default(0) // manuelle Reihenfolge; 0 überall = stabile Reihenfolge via createdAt

  // Taxonomie (Sprint Taxonomie 1)
  subcategory ProductSubcategory?  // null erlaubt — Bestandsprodukte ohne Unterkategorie
  labels      ProductLabel[]       @default([])
  futter      FutterKennzeichnung? // nur im Bereich Futtermittel (bereichVon)
  abgabe      Abgabe               @default(ALLE) // ≠ ALLE nur im Bereich Futtermittel

  // Lebensmittel-spezifisch
  allergens       String[] @default([])
  // isOrganic: Altlast, wird in einem späteren Sprint entfernt. Seit Sprint
  // Taxonomie 1 ist labels (BIO) die Wahrheit; diese Spalte wird nur noch
  // gelesen, nie mehr geschrieben.
  isOrganic       Boolean  @default(false)
  requiresCool    Boolean  @default(false)
  requiresFreezer Boolean  @default(false)

  // Saisonalität
  seasonStart Int? // Monat 1-12
  seasonEnd   Int?

  // Inaktiv-Grund
  unavailableReason String? // z.B. "Saison vorbei, wieder ab November"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm        Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  manualSales ManualSale[]

  @@index([farmId])
  @@index([isAvailable])
  @@index([category])
}

// Futtermittel-Kennzeichnung (Sprint Taxonomie 1, erweitert in Bereiche 1).
// Pflicht im Bereich Futtermittel, sonst verboten — die Regel sitzt im Zod-Schema
// (src/schemas/product.ts), die Datenbank hält nur die Daten. 1:1 zum Produkt,
// stirbt mit ihm. Die Angaben stammen vom Sackanhänger bzw. Lieferschein; der
// Hof bestätigt das ausdrücklich (bestaetigtAm).
model FutterKennzeichnung {
  id                      String    @id @default(cuid())
  productId               String    @unique
  zielTierarten           Tierart[]
  zusammensetzung         String    @db.Text // Mischfutter: Einzelfuttermittel absteigend
  analytischeBestandteile String    @db.Text // Rohprotein, Rohfaser … Freitext
  zusatzstoffe            String?   @db.Text
  // ALTLAST seit Bereiche 1 (Rückfrage F6): Die Nummer gehört dem Hof
  // (Farm.betriebsnummer). Wird nicht mehr geschrieben, nur noch als Rückfall
  // gelesen, wenn Farm.betriebsnummer leer ist. Cleanup-Sprint entfernt sie.
  registrierungsnummer    String?
  gebrauchshinweis        String?   @db.Text
  bestaetigtAm            DateTime  // Hof bestätigt Übereinstimmung mit Sackanhänger
  futtermittelart         Futtermittelart // Pflicht, erlaubte Werte je Kategorie
  nettoMenge              Decimal   @db.Decimal(10, 3) // Inhalt EINES Gebindes, nicht Bestand
  nettoEinheit            NettoEinheit
  // Prozentwerte für Filter und Vergleich. Die Pflichtangabe bleibt der
  // Freitext analytischeBestandteile.
  rohprotein              Decimal?  @db.Decimal(5, 2)
  rohfaser                Decimal?  @db.Decimal(5, 2)
  rohfett                 Decimal?  @db.Decimal(5, 2)
  rohasche                Decimal?  @db.Decimal(5, 2)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PickupSlot {
  id         String  @id @default(cuid())
  farmId     String
  dayOfWeek  Int     // 0=Sonntag, 1=Montag, ..., 6=Samstag
  startTime  String  // "14:00"
  endTime    String  // "16:00"
  maxOrders  Int?    // null = unbegrenzt
  isActive   Boolean @default(true)

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // z.B. HM-2611-A4F2

  farmId     String
  customerId String? // null bei reinem Gast

  // Kundendaten (auch redundant gespeichert für Gäste)
  customerEmail String
  customerName  String
  customerPhone String
  customerNote  String? @db.Text

  // Bestellung
  status      OrderStatus @default(PENDING_CONFIRMATION)
  totalAmount Decimal     @db.Decimal(10, 2)

  // Abholung
  pickupDate      DateTime
  pickupTimeStart String    // "14:00"
  pickupTimeEnd   String    // "16:00"
  pickedUpAt      DateTime?

  // Zahlung
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  paidAt                DateTime?

  // Vor-Ort-Bestätigung
  confirmationToken String?   @unique // für E-Mail-Link
  confirmedAt       DateTime?

  // Idempotenz des Checkouts (Bug-Report Befund 4): Der Browser erzeugt beim
  // ÖFFNEN des Checkouts einen Schlüssel und schickt ihn mit. Kommt derselbe
  // Schlüssel ein zweites Mal — Doppelklick, Zurück-Taste, wackeliges Netz,
  // erneut gesendetes Formular —, liefert der Server die BESTEHENDE Bestellung
  // zurück, statt eine zweite anzulegen. Der eindeutige Index ist die
  // Durchsetzung; ein deaktivierter Knopf allein ist keine.
  // Nullable und ohne Backfill: Bestandsbestellungen bleiben leer, und in
  // Postgres schließen sich mehrere NULL-Werte in einem UNIQUE nicht aus.
  idempotencyKey String? @unique

  // Plattformgebühr (für Reporting)
  platformFeeAmount Decimal @default(0) @db.Decimal(10, 2)

  // Servicegebühr — SNAPSHOT zur Bestellzeit (Sprint servicegebuehr).
  // totalAmount bleibt der WARENPREIS (das ist der Umsatz des Hofes und die
  // Basis aller Auswertungen); die Gebühr steht daneben in Cent. Was die
  // Kundin zahlt, ist totalAmount + serviceFeeCents. Ändert der Betreiber
  // später die Hofeinstellung (Farm.serviceFee*), bleiben bestehende
  // Bestellungen unverändert — Prozentsatz und Betrag stehen hier fest.
  // Bestandsbestellungen behalten 0 Cent, kein Backfill.
  //   serviceFeeCents          Gebühr in Cent, 0 = gebührenfrei
  //   serviceFeePercentApplied der angewendete Prozentsatz, null wenn 0 Cent
  //   serviceFeeRefundedAt     gesetzt, wenn die Gebühr entfallen ist
  //                            (nicht abgeholt: bar = nicht der Abrechnung
  //                            geschuldet, online = über Stripe erstattet)
  serviceFeeCents          Int       @default(0)
  serviceFeePercentApplied Decimal?  @db.Decimal(5, 2)
  serviceFeeRefundedAt     DateTime?

  // Käuferart (Sprint Bereiche 1). BETRIEB ist Pflicht, sobald eine Position
  // mit abgabe = NUR_BETRIEBE im Korb liegt — geprüft im Checkout-Handler.
  // betriebsnummer ist ein Snapshot der Eingabe, nur bei BETRIEB gesetzt.
  kaeuferArt     KaeuferArt @default(PRIVAT)
  betriebsnummer String?

  // Storno
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm     Farm       @relation(fields: [farmId], references: [id])
  customer User?      @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([farmId])
  @@index([customerEmail])
  @@index([status])
  @@index([pickupDate])
  // Siehe ManualSale: Fremdschlüssel ohne Index (Supabase-Hinweis).
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Snapshot zum Bestellzeitpunkt
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(10, 2)
  // MwSt-Satz zum Kaufzeitpunkt (Sprint Bereiche 1). Wird im Checkout aus
  // Product.vatRate geschrieben, nie nachgelesen, nie rückwirkend geändert.
  // Bewusst ohne @default: Jede neue Position muss den Satz mitbringen.
  vatRate     Decimal @db.Decimal(5, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  // Siehe ManualSale: Fremdschlüssel ohne Index (Supabase-Hinweis). Hier am
  // deutlichsten — die Löschsperre auf Product prüft genau diese Spalte.
  @@index([productId])
}

model ManualSale {
  id     String @id @default(cuid())
  farmId String

  // Produkt (optional aus Katalog)
  productId   String?
  productName String      // Pflichtfeld, da Produkt optional
  quantity    Decimal     @db.Decimal(10, 3)
  unit        ProductUnit?
  totalAmount Decimal     @db.Decimal(10, 2)

  // Kontext
  channel  SalesChannel
  saleDate DateTime     @default(now())
  note     String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([farmId])
  @@index([saleDate])
  @@index([channel])
  // Fremdschlüssel ohne Index — Postgres legt für FKs KEINEN an. Jede
  // Produktlöschung prüft die Gegenseite dann per Seq Scan (offener
  // Supabase-Leistungshinweis).
  @@index([productId])
}

model StockReservation {
  id        String   @id @default(cuid())
  productId String
  sessionId String
  quantity  Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([productId, sessionId])
  @@index([expiresAt])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  type           String
  createdAt      DateTime @default(now())

  @@index([stripeEventId])
}

model CustomerFarmSubscription {
  id            String  @id @default(cuid())
  customerEmail String
  farmId        String
  optInEmail    Boolean @default(false)
  optInWhatsApp Boolean @default(false)
  customerPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([customerEmail, farmId])
  @@index([farmId, optInEmail])
  @@index([farmId, optInWhatsApp])
}

model StatusPost {
  id                     String           @id @default(cuid())
  farmId                 String
  title                  String
  body                   String           @db.Text
  anlass                 StatusPostAnlass @default(FRESH_PRODUCT)
  photoUrl               String?
  linkedProductIds       String[]         @default([])
  publishedAt            DateTime?
  expiresAt              DateTime?
  showOnFarmPage         Boolean          @default(true)
  sentViaEmail           Boolean          @default(false)
  sentViaWhatsApp        Boolean          @default(false)
  emailRecipientCount    Int              @default(0)
  whatsappRecipientCount Int              @default(0)
  whatsappSentCount      Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, publishedAt])
