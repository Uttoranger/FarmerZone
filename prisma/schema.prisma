// Eine Meldung aus dem Fehlerbriefkasten (siehe GRUNDSATZ bei den Enums).
//
// Zwei Feldgruppen: was die MELDENDE Person liefert (art, text, Kontext), und
// die TRIAGE-Felder, die nur der Betreiber setzt (Admin-Bereich oder
// Datenbank-Connector — nie das Lese-CLI). Welche Felder ein Hof zu sehen
// bekommt, entscheidet EINE reine Funktion (fuerHof in src/lib/meldung.ts):
// text, art, createdAt, der übersetzte Status und antwortAnMelder — nie
// triageNotiz, clusterKey, duplikatVonId, sprintName.
//
// Kontext: seiteUrl, userAgent und viewport kommen aus dem Browser und werden
// im Formular sichtbar erklärt. KEINE IP, keine Cookies. farmId nur bei
// eingeloggtem Hof (Session, nie aus dem Formular); customerEmail freiwillig,
// „nur für Rückfragen". Aufbewahrung: erledigte Meldungen werden 90 Tage nach
// der Triage vom Wochenlauf gelöscht (api/cron/briefkasten), samt Screenshot.
model Meldung {
  id           String      @id @default(cuid())
  art          MeldungArt
  text         String      @db.Text // max 2000 Zeichen, erzwungen im Zod-Schema
  seiteUrl     String
  userAgent    String
  viewport     String
  farmId       String?
  customerEmail String?
  screenshotUrl String?
  // Freiwillige Kennung aus einer Fehlermeldung, z. B. „S71" (src/lib/upload-fehler.ts)
  diagKennung  String?
  createdAt    DateTime    @default(now())

  // Triage (nur Betreiber)
  status         MeldungStatus @default(NEU)
  clusterKey     String?   // Bündel-Schlüssel, vor allem für die gezählte Wunschliste
  triageNotiz    String?   @db.Text
  duplikatVonId  String?   // ID der ursprünglichen Meldung; Existenz prüft die Action
  sprintName     String?
  triagedAt      DateTime?
  antwortAnMelder String?  // kurzer Text, für den Hof sichtbar

  // SetNull statt Restrict: Wird ein (Bot-)Hof abgelehnt und gelöscht, bleibt
  // die Meldung als hoflose Meldung stehen, statt das Löschen zu blockieren.
  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([clusterKey])
  @@index([farmId])
}

// Ein laufender Kostenposten der PLATTFORM — nicht eines Hofes. Der Betreiber
// trägt ihn einmal ein („Hosting, 20 €, monatlich, ab September 2026"), die
// Finanzseite legt ihn gegen die Servicegebühren des Monats.
//
// ab und bis sind DATE, nicht DateTime: Ein Monat ist ein Kalenderdatum, kein
// Zeitpunkt. Als Zeitstempel könnte die Umrechnung zwischen Wiener Zeit und UTC
// einen Posten in den Vormonat schieben. Gespeichert wird immer der ERSTE eines
// Monats; bis ist der LETZTE Monat, in dem der Posten zählt (einschließlich),
// null heißt „läuft weiter".
//
// Kein Fremdschlüssel, kein Hofbezug, keine Fremdwährung: Beträge in Euro, so
// wie sie abgebucht werden. Ein Überblick, keine Buchhaltung.
model Kostenposten {
  id        String          @id @default(cuid())
  name      String
  kategorie KostenKategorie
  betrag    Decimal         @db.Decimal(10, 2)
  rhythmus  KostenRhythmus
  ab        DateTime        @db.Date
  bis       DateTime?       @db.Date
  notiz     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}
